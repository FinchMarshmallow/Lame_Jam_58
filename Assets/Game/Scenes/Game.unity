  m_Script: {fileID: 11500000, guid: 2e1522fa7079310499d6092da2b3e93d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MissionSystem
  missionPanel: {fileID: 919554174}
  headerText: {fileID: 1413014199}
  descText: {fileID: 467399250}
  routeText: {fileID: 1761551378}
  compassSystem: {fileID: 618896776}
  mapSystem: {fileID: 1660984320}
  allMissions:
  - description: The mining colony on Mars urgently needs new drilling rigs. Pick
      up the heavy machinery from Earth and try not to scratch the paint while docking.
    missionName: Operation Red Dust
    pickupStation: {fileID: 11400000, guid: 08ae1213b10ce9d49a1645b8fdd5898b, type: 2}
    deliverStation: {fileID: 11400000, guid: a1c8280bb96b9754a90f5898c73dfecf, type: 2}
  - description: ' Mars has mined a ton of raw iron ore. The factories on Venus need
      raw materials to build ship hulls. This cargo is extremely heavy, watch your
      inertia.'
    missionName: Heavy Metal Run
    pickupStation: {fileID: 11400000, guid: a1c8280bb96b9754a90f5898c73dfecf, type: 2}
    deliverStation: {fileID: 11400000, guid: e16fb18ecdc3b5a49ae152cde9841949, type: 2}
  - description: ' Scientists on Mercury are complaining that their equipment is
      melting. Venus has produced a batch of new thermal shields. Deliver them before
      the lab burns down.'
    missionName: Into the Fire
    pickupStation: {fileID: 11400000, guid: 51f32dc819a37dc40b42fc4c36340736, type: 2}
    deliverStation: {fileID: 11400000, guid: a1c8280bb96b9754a90f5898c73dfecf, type: 2}
  - description: Earth is running out of power. Saturn has prepared containers with
      liquid Helium-3. This is a volatile cargo, do not crash into the docks.
    missionName: Energy Lifeline
    pickupStation: {fileID: 11400000, guid: 57ab4b4729d510d4ba2a14c92eb0ccd1, type: 2}
    deliverStation: {fileID: 11400000, guid: dac16a3da77f6464fb0acbe9ca66963e, type: 2}
  - description: Mercury has synthesized a new type of explosive for deep drilling.
      The miners on Mars are waiting for this package. Careful, any impact could
      be your last.
    missionName: The Big Bang
    pickupStation: {fileID: 11400000, guid: 57ab4b4729d510d4ba2a14c92eb0ccd1, type: 2}
    deliverStation: {fileID: 11400000, guid: dac16a3da77f6464fb0acbe9ca66963e, type: 2}
  - description: The air purification system at the Saturn gas rig has failed. Pick
      up new filters from Earth and deliver them ASAP, they are running out of oxygen.
    missionName: Breath of Life
    pickupStation: {fileID: 11400000, guid: 08ae1213b10ce9d49a1645b8fdd5898b, type: 2}
    deliverStation: {fileID: 11400000, guid: bbba6cc72a126e34faf17e123eb3cc0e, type: 2}
  - description: ' The chip factories on Venus need concentrated acid for etching
      circuits. Mercury labs have prepared the tanks'
    missionName: ' Acid Trip'
    pickupStation: {fileID: 11400000, guid: 08ae1213b10ce9d49a1645b8fdd5898b, type: 2}
    deliverStation: {fileID: 11400000, guid: bbba6cc72a126e34faf17e123eb3cc0e, type: 2}
  currentMissionIndex: 0
